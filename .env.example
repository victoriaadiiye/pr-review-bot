SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# GitHub auth (pick ONE):
# Option A: GitHub App (preferred — scoped, auto-rotating tokens)
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY_FILE=/path/to/private-key.pem
# Option B: Personal access token
# GH_TOKEN=ghp_your-classic-pat

# Claude CLI: auth is mounted from ~/.claude via docker-compose
# If using API key instead: set ANTHROPIC_API_KEY=sk-ant-...
WATCHED_CHANNEL_ID=your-private-channel-id
# Multiple channels: WATCHED_CHANNEL_ID=C123,C456,C789
# All channels where bot is invited: WATCHED_CHANNEL_ID=*
NOTIFY_USER_ID=U0AAA401YTT

# Optional: concurrency and queue settings (defaults shown)
# REVIEW_WORKERS=3
# REVIEW_QUEUE_SIZE=10

# Optional: health server port (default 8080)
# HEALTH_PORT=8080

# Optional: extra questions Claude should answer about each PR
# REVIEW_QUESTIONS="Does this follow our error handling patterns?\nAre there any missing tests?"

# Optional: Claude model (defaults to claude-opus-4-6)
# CLAUDE_MODEL=claude-opus-4-6

# Optional: midnight jobs — auto-review + stale PR detection, daily at midnight
# AUTO_REVIEW_REPOS=Qumulo/qompass,Qumulo/qatalyst
# AUTO_REVIEW_BOT_LOGIN=qompass-pr-review-bot
# STALE_PR_DAYS=14
# STALE_REPORT_CHANNEL=C0B0XUUSTDW  # channel to post stale PR reports (default: DM notify user)

# Optional: Jira integration (auto-detects ticket keys from message or PR title)
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your-jira-api-token
